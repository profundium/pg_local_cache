---
layout: null
permalink: /sitemap.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% unless site.preview %}
{% assign pages = site.pages | sort: 'url' %}
{% for item in pages %}{% if item.sitemap != false %}{% if item.home or item.layout == 'doc' %}
  <url>
    <loc>{{ item.url | absolute_url | xml_escape }}</loc>
    {% if item.last_modified_at %}<lastmod>{{ item.last_modified_at | date: '%Y-%m-%d' }}</lastmod>{% endif %}
  </url>
{% endif %}{% endif %}{% endfor %}
{% endunless %}
</urlset>
